@namespace OkBlazor
<ok-fv-text-field
    @ref="_element"
    type="@Type"
    value="@Value"
    placeholder="@Placeholder"
    disabled="@Disabled"
    readonly="@ReadOnly"
    required="@Required"
    @onchange="OnChange"
    @attributes="AdditionalAttributes">
    @ChildContent
</ok-fv-text-field>
