@namespace OkBlazor
<ok-fv-chip-selector
    disabled="@Disabled"
    open="@Open"
    label="@Label"
    selected-values="@SelectedValues"
    options="@Options"
    placeholder="@Placeholder"
    allow-custom-values="@AllowCustomValues"
    @attributes="AdditionalAttributes">
    @ChildContent
</ok-fv-chip-selector>
