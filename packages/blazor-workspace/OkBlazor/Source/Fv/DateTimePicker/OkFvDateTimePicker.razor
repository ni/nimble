@namespace OkBlazor
<ok-fv-date-time-picker
    appearance="@Appearance"
    type="@Type"
    min="@Min"
    max="@Max"
    step="@Step"
    readonly="@ReadOnly"
    autofocus="@AutoFocus"
    autocomplete="@AutoComplete"
    placeholder="@Placeholder"
    full-bleed="@FullBleed"
    appearance-readonly="@AppearanceReadOnly"
    open="@Open"
    current-value="@Value"
    disabled="@Disabled"
    required="@Required"
    @oninput="HandleInputAsync"
    @onchange="HandleChangeAsync"
    @attributes="AdditionalAttributes">
    @ChildContent
</ok-fv-date-time-picker>
