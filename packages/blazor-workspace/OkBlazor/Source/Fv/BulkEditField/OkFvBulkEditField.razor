@namespace OkBlazor
<ok-fv-bulk-edit-field
    data-ok-fv-event-source="@_eventSource"
    label="@Label"
    status="@Status"
    reset-disabled="@ResetDisabled"
    clear-disabled="@ClearDisabled"
    @onokfvreset="HandleResetAsync"
    @onokfvclear="HandleClearAsync"
    @attributes="AdditionalAttributes">
    @ChildContent
</ok-fv-bulk-edit-field>
