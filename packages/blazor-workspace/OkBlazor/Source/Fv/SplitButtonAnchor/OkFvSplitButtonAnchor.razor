@namespace OkBlazor
<ok-fv-split-button-anchor
    label="@Label"
    href="@Href"
    target="@Target"
    rel="@Rel"
    download="@Download"
    disabled="@Disabled"
    open="@Open"
    appearance="@Appearance"
    appearance-variant="@AppearanceVariant"
    @onokfvtrigger="Trigger"
    @onokfvtoggle="Toggle"
    @attributes="AdditionalAttributes">
    @ChildContent
</ok-fv-split-button-anchor>
