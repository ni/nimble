@namespace OkBlazor
<ok-fv-split-button-anchor
    data-ok-fv-event-source="@_eventSource"
    label="@Label"
    href="@Href"
    target="@Target"
    rel="@Rel"
    download="@Download"
    disabled="@Disabled"
    open="@Open"
    appearance="@Appearance"
    appearance-variant="@AppearanceVariant"
    @onokfvtrigger="HandleTriggerAsync"
    @onokfvtoggle="HandleToggleAsync"
    @attributes="AdditionalAttributes">
    @ChildContent
</ok-fv-split-button-anchor>
