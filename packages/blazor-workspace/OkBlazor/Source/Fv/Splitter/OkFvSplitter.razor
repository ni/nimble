@namespace OkBlazor
<ok-fv-splitter
    aria-label="@AriaLabel"
    aria-labelledby="@AriaLabelledBy"
    aria-controls="@AriaControls"
    position="@Position"
    min="@Min"
    max="@Max"
    step="@Step"
    @onokfvpositioninput="HandleInputAsync"
    @onokfvpositionchange="HandleChangeAsync"
    @attributes="AdditionalAttributes">
</ok-fv-splitter>
