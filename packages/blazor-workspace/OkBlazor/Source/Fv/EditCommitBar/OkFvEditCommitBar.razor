@namespace OkBlazor
<ok-fv-edit-commit-bar
    data-ok-fv-event-source="@_eventSource"
    @ref="_element"
    heading="@Heading"
    change-count="@ChangeCount"
    affected-row-count="@AffectedRowCount"
    hidden-affected-row-count="@HiddenAffectedRowCount"
    save-disabled="@SaveDisabled"
    revert-disabled="@RevertDisabled"
    actions-hidden="@ActionsHidden"
    hide-empty-summary="@HideEmptySummary"
    @onokfvsave="HandleSaveAsync"
    @onokfvrevert="HandleRevertAsync"
    @onokfvdismissmessage="HandleDismissMessageAsync"
    @attributes="AdditionalAttributes">
    @ChildContent
</ok-fv-edit-commit-bar>
