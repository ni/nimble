@typeparam TCloseReason
@namespace NimbleBlazor
<nimble-dialog
    @onnimbleblur="HandleBlur"
    @ref="_dialogElement"
    prevent-dismiss="@PreventDismiss"
    header-hidden="@HeaderHidden"
    footer-hidden="@FooterHidden"
    @attributes="AdditionalAttributes">
    @ChildContent
</nimble-dialog>
