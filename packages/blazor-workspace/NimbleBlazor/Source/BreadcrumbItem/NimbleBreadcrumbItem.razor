@namespace NimbleBlazor
<nimble-breadcrumb-item
    @onblur="HandleBlur"
    href="@Href"
    hreflang="@HrefLang"
    ping="@Ping"
    referrerpolicy="@ReferrerPolicy"
    rel="@Rel"
    target="@Target"
    type="@Type"
    @attributes="AdditionalAttributes">
    @ChildContent
</nimble-breadcrumb-item>
