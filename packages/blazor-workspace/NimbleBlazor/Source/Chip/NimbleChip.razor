@namespace NimbleBlazor
<nimble-chip
    @onnimbleblur="EventUtilities.AsNonRenderingEventHandler<EventArgs>(HandleBlur)"
    removable="@Removable"
    disabled="@Disabled"
    @onnimblechipremove="HandleRemove"
    appearance="@Appearance.ToAttributeValue()"
    @attributes="AdditionalAttributes">
    @ChildContent
</nimble-chip>
