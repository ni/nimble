@namespace NimbleBlazor
<nimble-tooltip
    @onnimbleblur="EventUtilities.AsNonRenderingEventHandler<EventArgs>(HandleBlur)"
    anchor="@Anchor"
    delay="@Delay"
    severity="@Severity.ToAttributeValue()"
    icon-visible="@IconVisible"
    @attributes="AdditionalAttributes">
    @ChildContent
</nimble-tooltip>
