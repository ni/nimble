@namespace Demo.Shared.Pages.Sections

<div>
    <SubContainer Label="Select">
        <NimbleSelect Appearance="DropdownAppearance.Underline" FilterMode="FilterMode.Standard" Clearable="true" FocusOut="FocusOutFunction">
            Underline Select
            <NimbleListOptionGroup Label="Group 1">
                <NimbleListOption>Option 1</NimbleListOption>
                <NimbleListOption>Option 2</NimbleListOption>
            </NimbleListOptionGroup>
            <NimbleListOptionGroup Label="Group 2">
                <NimbleListOption>Option 3</NimbleListOption>
                <NimbleListOption>Option 4</NimbleListOption>
            </NimbleListOptionGroup>
        </NimbleSelect>
        <NimbleSelect Appearance="DropdownAppearance.Outline" FocusOut="FocusOutFunction">
            Outline Select
            <NimbleListOptionGroup Label="Group 1">
                <NimbleListOption>Option 1</NimbleListOption>
                <NimbleListOption>Option 2</NimbleListOption>
            </NimbleListOptionGroup>
            <NimbleListOptionGroup Label="Group 2">
                <NimbleListOption>Option 3</NimbleListOption>
                <NimbleListOption>Option 4</NimbleListOption>
            </NimbleListOptionGroup>
        </NimbleSelect>
        <NimbleSelect Appearance="DropdownAppearance.Block" FocusOut="FocusOutFunction">
            Block Select
            <NimbleListOptionGroup Label="Group 1">
                <NimbleListOption>Option 1</NimbleListOption>
                <NimbleListOption>Option 2</NimbleListOption>
            </NimbleListOptionGroup>
            <NimbleListOptionGroup Label="Group 2">
                <NimbleListOption>Option 3</NimbleListOption>
                <NimbleListOption>Option 4</NimbleListOption>
            </NimbleListOptionGroup>
        </NimbleSelect>
    </SubContainer>
</div>

@code
{
    private void FocusOutFunction()
    {
        Console.WriteLine("Focus out event triggered");
    }
}
